# CyberMirror example configuration
# Copy this file to .env and adjust only what you need.

# Backend
# Local default stays localhost. Docker/Compose sets HOST=0.0.0.0 so published ports work.
HOST=127.0.0.1
PORT=8787
DEBUG=false
API_AUTH_ENABLED=true
# Optional: set explicitly (launcher/Docker volume otherwise persist data/.api_token).
# API_TOKEN=
ENCRYPTION_ENABLED=true

# Scanner behavior
PLAYWRIGHT_ENABLED=true
USERNAME_SCAN_LIMIT=600
WEB_SEARCH_MAX_QUERIES=30
WEB_SEARCH_RESULTS_PER_QUERY=8
CACHE_TTL_SECONDS=3600

# Optional integrations
# Place the WhatsMyName dataset at data/wmn-data.json, or override the path:
# WMN_DATA_PATH=data/wmn-data.json
# HIBP_API_KEY=

# Scheduler
SCHEDULE_ENABLED=false
SCHEDULE_INTERVAL_HOURS=168
